  m_Script: {fileID: 11500000, guid: bbb0c253e594446d0ae0e4e909f3e8d9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NewMonoBehaviourScript
  nameText: {fileID: 178629107}
  dialogueText: {fileID: 899741109}
  bodyLanguageText: {fileID: 1826074219}
  questionButtons:
  - {fileID: 1295925385}
  - {fileID: 1223124780}
  - {fileID: 509241414}
  questionPanel: {fileID: 607930894}
  judgePanel: {fileID: 377696265}
  continuePanel: {fileID: 1842164116}
  suspects:
  - name: Sebastian
    questions:
    - questionText: Where were you last night?
      answer: Shelving the third-edition atlases in the east wing, until precisely
        9:47. Then I stepped outside at 9:52 for exactly five minutes. The air was
        cool, the sky perfectly clear.
      bodyLanguage: Perfectly still. Holds your gaze a beat too long.
      isLie: 1
      reactionIfCalledLiar: A bold accusation. I trust you have something to support
        it, detective?
      reactionIfCalledTruth: Thank you. I do value being believed.
    - questionText: Did you see anyone near the cellar?
      answer: "I did see Marguerite near the cellar around then... though I wouldn\u2019t
        dream of accusing anyone."
      bodyLanguage: "Doesn\u2019t blink. Hands folded, motionless."
      isLie: 1
      reactionIfCalledLiar: Think what you like. I merely said what I saw.
      reactionIfCalledTruth: Good. Someone should look closely at her.
    - questionText: What was your relationship with the victim?
      answer: We were acquaintances. He asked a great many questions, as scholars
        do. I answered the ones that mattered.
      bodyLanguage: Still as a statue. A faint, practiced smile.
      isLie: 0
      reactionIfCalledLiar: Curious. People usually find me rather forthcoming.
      reactionIfCalledTruth: How refreshing.
  questionsPerSuspect: 2
